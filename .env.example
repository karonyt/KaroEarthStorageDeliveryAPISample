PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# storage-delivery-api public/admin base URL
STORAGE_DELIVERY_API_BASE_URL=https://storage-delivery.karon.jp

# Optional marketplace display name
MARKETPLACE_NAME=KaroMall

# Single-store setup. Issue these from account-link /me -> SHOP API 管理.
STORAGE_DELIVERY_SITE_ID=
STORAGE_DELIVERY_SITE_ADMIN_TOKEN=
STORAGE_DELIVERY_SITE_LABEL=

# Multi-store setup. JSON array is recommended.
# MARKETPLACE_SITES=[{"siteId":"sds_xxx","adminToken":"sdt_xxx","label":"Seller Shop"}]
MARKETPLACE_SITES=

# Safety knobs
MARKETPLACE_ORDER_RATE_LIMIT_PER_MINUTE=20
MARKETPLACE_CATALOG_CACHE_SECONDS=10
